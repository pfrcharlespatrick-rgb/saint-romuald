e","cle_maison":"1871-D1-M42","lieux":[],"trajectoire":{"mentions":[{"id":"1871-D1-P017-L04","annee":"1871","division":"1","nom":"Germain Cantin","attribut":"38 ans · maison 42, famille 61 · chef(fe) de ménage","page_ms":"17","ligne":"4"},{"id":"1881-D1-P012-L16","annee":"1881","division":"1","nom":"Germain Cantin","attribut":"48 ans · maison 43, famille 53 · chef(fe) de ménage","page_ms":"12","ligne":"16"},{"id":"1891-D1-P137-L05","annee":"1891","division":"1","division_reconstituee":"1","nom":"Germain Cantin","attribut":"58 ans · maison 612, famille 612 · chef(fe) de ménage","page_ms":"137","ligne":"5"}],"liaisons":[{"confiance":"forte","motifs":["patronyme identique","prénom concordant","âge cohérent (38 → 48, écart de 10 ans)","sexe concordant","2 autre(s) membre(s) du ménage se retrouvent ensemble"],"score":1},{"confiance":"forte","motifs":["patronyme identique","prénom concordant","âge cohérent (48 → 58, écart de 10 ans)","sexe concordant","1 autre(s) membre(s) du ménage se retrouvent ensemble"],"score":1}]},"maisonnee":{"entetes":["Nom","Sexe","Âge","Né(e)","Origine","Profession","École"],"lignes":[{"id":"1871-D1-P017-L04","ligne":"4","chef":true,"courante":true,"valeurs":["Germain Cantin","M","38","Québec","Française","Marchand",""]},{"id":"1871-D1-P017-L05","ligne":"5","chef":false,"courante":false,"valeurs":["Rosalie Cantin","F","31","Québec","Française","—",""]},{"id":"1871-D1-P017-L06","ligne":"6","chef":false,"courante":false,"valeurs":["Louis Cantin","M","6","Québec","Française","—","✓"]},{"id":"1871-D1-P017-L07","ligne":"7","chef":false,"courante":false,"valeurs":["Arthur Cantin","M","3","Québec","Française","—",""]},{"id":"1871-D1-P017-L08","ligne":"8","chef":false,"courante":false,"valeurs":["Amédée Cantin","M","8 mois","Québec","Française","—",""]}]},"evenements":[],"documents":[{"id":"notarie-1874-05-19-quittance-gosselin-houde","titre":"Quittance de Luce Gosselin à Honoré Houde et Joseph Picard, 1874","type":"notarie","source":"Greffe du notaire Elzéar-Hubert Tremblay (1873-1900), Saint-Romuald — microfilm","cote":"Minute n° 117, images 001518 à 001522","date":"1874-05-19","transcription":"« L'an mil huit cent soixante-quatorze, le dix-neuf de mai, après-midi, en présence de Elzéar Hubert Tremblay, notaire public […] Fut présente : Demoiselle Luce Gosselin, ci-devant de St Jean Chrysostome, dit comté, & maintenant de St Romuald, servante ; Laquelle dit & déclare ce qui suit, savoir : Attendu que ladite comparante a, en date de ce jour, suivant acte exécuté par le notaire soussigné, protesté & sommé Sr Honoré Houde pour certaines causes mentionnées au long au dit acte de protêt & sommation ; Attendu que pour le bon ordre & afin de conserver la paix entre la dite comparante & le dit sieur Houde, ce dernier consent à payer la somme de deux piastres, prix du salaire […] » — [001519-20] « […] salaire convenu & dû à la comparante ; & de payer en outre les frais du dit acte de sommation & des présentes, & de faire réparer à ses frais les objets brisés par la comparante durant le laps de temps de son service chez le dit sieur Houde. Et attendu en outre que Godias Picard, fils mineur de Sr Joseph Picard, marchand, a, par inadvertance, injurié la comparante. Et attendu que les parties, savoir : la comparante pour elle-même, le dit Sr Houde pour lui & son épouse, & ledit Sr Jos. Picard pour son dit fils, veulent que la paix soit rétablie entre eux, » — [001520-21] « C'est pourquoi la dite comparante donne & accorde à tous les intéressés, parties aux présentes & susmentionnés, quittance générale & finale de toutes & chacune les réclamations qu'elle a ou pourrait avoir contre elles […] & veut & consent que les choses en demeurent dans le même état que si jamais elles n'eussent existé. Dont & du tout elle a requis le présent acte qui a été octroyé à St Romuald susdit, étude du dit notaire, les jour, mois & an susdits, sous le numéro cent dix-sept des originaux du notaire soussigné. Et la comparante requise de signer a déclaré ne le savoir, en présence de [Mr Germain Cantin, de St Romuald susdit, marchand, rayé] » — [001521-22] « Mr Mathias Gaumont, du dit lieu de St Romuald, ferblantier, témoin au présent acte, qui a signé avec moi notaire, lecture faite. » Signatures : « Mathias Gaumont », « E. H. Tremblay N.P. »","affirmations":[]},{"id":"notarie-1874-05-21-echange-grenier-proulx","titre":"Échange entre Georges Grenier et François-Xavier Proulx, 1874","type":"notarie","source":"Greffe du notaire Elzéar-Hubert Tremblay (1873-1900), Saint-Romuald — microfilm","cote":"Minute n° 118, images 001522 à 001529","date":"1874-05-21","transcription":"« L'an mil huit cent soixante-quatorze, le vingt-et-unième jour de mai, avant-midi, en présence de Elzéar Hubert Tremblay, notaire public […] Et en présence de Germain Cantin, écr, marchand, demeurant au dit lieu de St Romuald, dit comté, témoin au présent acte, aussi soussigné ; Furent présents : Mr Georges Grenier, cultivateur, de la paroisse de St Elzéar, comté de Beauce, district de Québec, d'une part ; Et Mr François Xavier Proulx, du dit lieu de St Romuald, batelier, d'autre part ; Lesquelles parties […] ont fait les échanges & permutations réciproques des immeubles ci-après désignés, avec garantie réciproque & mutuelle de tous troubles, dons, dettes, douaires, hypothèques […] savoir : Le dit sieur Georges Grenier a donné à titre d'échange dès ce jour & à toujours au dit sieur François Xavier Proulx, à ce présent & acceptant […] : Un demi-arpent de terre de front sur dix arpents de profondeur, le tout plus ou moins, borné par devant au nord au chemin public, par derrière au sud au dit sieur Grenier, à l'est à Dame Constance Parent, épouse du dit sieur Grenier, & à l'ouest au dit sieur F. X. Proulx, (1) circonstances & dépendances, avec la réserve des bâtisses dessus construites en faveur du dit sieur Grenier. Le dit lopin de terre situé en la dite paroisse de St Elzéar de Beauce & appartenant au dit sieur Grenier, avec plus grande étendue, suivant avantages matrimoniaux consentis en sa faveur par Dame Constance Parent, son épouse, tel qu'il appert par leur contrat de mariage […] » — [001524-25] « Pour par le dit Sr Proulx jouir, faire & disposer du dit lopin de terre dès ce jour & à toujours en pleine & entière propriété. Et en contre-échange le dit Sr F. X. Proulx cède & abandonne dès maintenant & à toujours au dit Sr George Grenier, à ce aussi présent & acceptant […] savoir : Un lopin de terre situé en la dite paroisse de St Elzéar, comté susdit, contenant un demi-arpent de front sur dix arpents de profondeur, borné en arrière au sud à Vital Allaire ou ses représentants, au nord au dit sieur Proulx, à l'est au dit sieur Grenier & à l'ouest à Damase Vachon ou ses représentants, circonstances & dépendances. Au dit sieur François Xavier Proulx appartient le dit lopin de terre, avec plus grande étendue, suivant acte de partage qui a été fait & exécuté devant Mtre Chassé, notaire, des biens composant la communauté qui a existé entre feu Augustin Proulx, décédé intestat, & Dame Constance Parent, ses père & mère ; » — [001525-27] Charges : payer les redevances tenant lieu de droits seigneuriaux, s'il en existe ; payer les taxes municipales, scolaires et autres ; Grenier fera seul et à ses frais la clôture des deux immeubles, jusqu'à ce que Proulx prenne possession de son terrain ou en dispose ; entretenir les chemins et fossés. — [001527-28] « Dont acte. Fait & passé à St Romuald susdit, étude du dit notaire, les jour, mois & an susdits, sous le numéro cent dix-huit des originaux du notaire soussigné. Et le dit sieur Grenier a déclaré ne savoir écrire ni signer, de ce requis, en présence du dit témoin qui a alors signé, ainsi que le dit sieur Proulx, avec moi, notaire, lecture faite. » Signatures : « F. Xavier Proulx », « Germain Cantin », « E. H. Tremblay N.P. » — [001528-29] Croquis : quatre bandes d'un demi-arpent de front, orientées Nord-Sud, sur 20 arpents de profondeur en deux rangs de dix, Ouest à gauche, Est à droite ; chiffres « 2 », « 2 » au rang nord, « 2 », « 1 », « m », « P. » au rang sud (lecture : sans doute les parts du partage, « m » pour la mère et « P. » pour Proulx — à confirmer).","affirmations":[{"enonce":"Germain Cantin est écuyer et marchand à Saint-Romuald en 1874, et sait signer.","certitude":"etabli","type":"fonction"}]},{"id":"notarie-1874-05-30-quittance-lambert-tardif","titre":"Quittance de Germain Lambert à Louis Tardif, 1874","type":"notarie","source":"Greffe du notaire Elzéar-Hubert Tremblay (1873-1900), Saint-Romuald — microfilm","cote":"Minute n° 120, images 001535 à 001539","date":"1874-05-30","transcription":"« L'an mil huit cent soixante-quatorze, le trentième jour de mai, après-midi, en présence de Elzéar Hubert Tremblay, notaire public […] Et en présence de Germain Cantin, écuyer, marchand, de la paroisse de St Romuald, témoin au présent acte, aussi soussigné ; Fut présent Mr Germain Lambert, de la paroisse de St Jean Chrysostome, comté de Lévis, cultivateur ; Lequel dit & déclare ce qui suit, savoir : Attendu que lui, dit sieur Lambert, a, suivant acte de vente en date, à St Chrysostome susdit, du dix-neuf d'octobre mil huit cent cinquante-cinq, reçu par Mtre A. Trudelle [lu d'abord « Fruell »] & son confrère, notaires, vendu une certaine terre de la contenance décrite au dit acte de vente sus-daté à Mr Louis Tardif, de la paroisse de St Henri, cultivateur, pour & moyennant le prix de trois cent vingt-cinq louis courant ; Attendu qu'à compte duquel prix le dit sieur Tardif a, lors de l'exécution du dit acte de vente, payé la somme de cinquante louis courant ; Et attendu que le dit sieur Lambert a reçu partie avant & partie lors de l'exécution des présentes, à son entière satisfaction & en bon argent courant, le prix entier de la dite vente au montant de trois cent vingt-cinq louis courant, du dit sieur Louis Tardif ; C'est pourquoi lui, dit sieur Germain Lambert, donne & accorde par ces présentes au dit sieur Louis Tardif quittance générale & finale. […] Dont acte requis & octroyé à St Romuald susdit, étude du dit notaire, les jour, mois & an susdits, sous le numéro cent vingt des originaux du notaire soussigné. Et le dit sieur Germain Lambert, comparant, requis de signer, a déclaré ne le savoir, en présence du dit témoin qui a alors signé avec moi, notaire, lecture faite. » Signatures : « Germain Cantin », « E. H. Tremblay N.P. » — Passage barré, repris à l'acte 121 : « Attendu qu'en date du trente-un mars mil huit cent cinquante-six, le dit sieur Louis Tardif a, suivant acte de vente reçu par Mtre A. Trudelle [lu d'abord « Fruell »] & son confrère, notaires, vendu la dite terre à sieur Louis Paradis, son gendre, & à Dame Zoé Tardif, sa fille, demeurant tous deux à St Jean Chrysostome susdit, pour la dite somme de trois cent vingt-cinq louis courant, à la charge par les dits acquéreurs de lui rembourser la somme de cinquante louis payée à compte […] »","affirmations":[{"enonce":"Germain Cantin, écuyer, marchand de Saint-Romuald, sert de témoin au notaire Tremblay (actes 117, 118, 120, 121).","certitude":"etabli","type":"fonction"}]},{"id":"notarie-1874-05-30-quittance-tardif-paradis","titre":"Quittance de Louis Tardif à Louis Paradis et Zoé Tardif, 1874","type":"notarie","source":"Greffe du notaire Elzéar-Hubert Tremblay (1873-1900), Saint-Romuald — microfilm","cote":"Minute n° 121, images 001539 à 001542","date":"1874-05-30","transcription":"« L'an mil huit cent soixante-quatorze, le trentième jour de mai, après-midi, en présence de Elzéar Hubert Tremblay, notaire public […] Et en présence de Germain Cantin, écuyer, de St Romuald, marchand, témoin au présent acte, aussi soussigné ; Fut présent Mr Louis Tardif, de la paroisse de St Henri, cultivateur ; Lequel dit & déclare ce qui suit, savoir : Attendu que, en date du trente-un de mars mil huit cent cinquante-six, il a, suivant acte de vente reçu par Mtre Amb. Trudelle [lu d'abord « Fruell »] & son confrère, notaires, vendu une terre de la contenance décrite au dit acte […] » — [001540-42] « […] au dit acte de vente sus-daté, à sieur Louis Paradis, son gendre, & à Dame Zoé Tardif, sa fille, conjointement, & demeurant tous deux en la paroisse de St Jean Chrysostome, comté susdit, pour le prix de [trois cent vingt-cinq louis courant, rayé] deux cent soixante-quinze louis courant, à la charge, suivant convention verbale, de lui payer & rembourser la somme de cinquante louis payée à sieur Germain Lambert par le comparant sur le prix déterminé & fixé en une certaine vente consentie par le dit sieur Lambert en faveur du dit Sr Louis Tardif ; Attendu que la dite somme de cinquante louis a été payée & remboursée dès avant ces présentes ; Et attendu que le dit Sr Louis Paradis & la dite Dame Zoé Tardif, son épouse, ont, partie avant & partie lors de l'exécution des présentes, payé en bon argent courant la dite somme de deux cent soixante-quinze louis courant au dit sieur Louis Tardif, qui le reconnaît & s'en déclare satisfait ; C'est pourquoi lui, dit sieur Louis Tardif, donne & accorde par ces présentes quittance générale & finale au dit sieur Louis Paradis & à la dite Dame Zoé Tardif. Dont acte requis & octroyé à St Romuald susdit, étude du dit notaire, les jour, mois & an susdits, sous le numéro cent vingt-un des originaux du notaire soussigné. Et le comparant, requis de signer, a déclaré ne le savoir, en présence du dit témoin, qui a signé avec moi, notaire, lecture faite. » Signatures : « Germain Cantin », « E. H. Tremblay N.P. »","affirmations":[]}]},"1871-D1-P017-L05":{"id":"1871-D1-P017-L05","nom":"Cantin","prenom":"Rosalie","sexe":"F","age":"31","profession":"","etat_matrimonial":"M","etat_civil":"Marié(e)","annee":"1871","division":"1","no_maison":"42","no_famille":"61","chef":false,"page_ms":"17","ligne":"5","incertain":false,"remarque":"épouse","biffee":false,"lieu_naissance":"Québec","origine":"Française","religion":"Catholique","cle_maison":"1871-D1-M42","lieux":[],"trajectoire":null,"maiso