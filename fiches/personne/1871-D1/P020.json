,"ligne":"10","chef":false,"courante":false,"valeurs":["Adélaïde Guay","F","46","Québec","Française","—",""]},{"id":"1871-D1-P020-L11","ligne":"11","chef":false,"courante":false,"valeurs":["Malcolm Guay","M","23","Québec","Française","Étudiant en médecine",""]},{"id":"1871-D1-P020-L12","ligne":"12","chef":false,"courante":false,"valeurs":["George Guay","M","16","Québec","Française","—","✓"]},{"id":"1871-D1-P020-L13","ligne":"13","chef":false,"courante":false,"valeurs":["Arthur Guay","M","10","Québec","Française","—","✓"]},{"id":"1871-D1-P020-L14","ligne":"14","chef":false,"courante":false,"valeurs":["Ernest Guay","M","7","Québec","Française","—","✓"]},{"id":"1871-D1-P020-L15","ligne":"15","chef":false,"courante":false,"valeurs":["Althémise Guay","F","24","Québec","Française","—",""]},{"id":"1871-D1-P020-L16","ligne":"16","chef":false,"courante":true,"valeurs":["Luce Guay","F","18","Québec","Française","—",""]}]},"evenements":[],"documents":[]},"1871-D1-P020-L17":{"id":"1871-D1-P020-L17","nom":"Lagueux","prenom":"Edouard","sexe":"M","age":"73","profession":"Cultivateur","etat_matrimonial":"M","etat_civil":"Marié(e)","annee":"1871","division":"1","no_maison":"50","no_famille":"77","chef":true,"page_ms":"20","ligne":"17","incertain":false,"remarque":"","biffee":false,"lieu_naissance":"Québec","origine":"Française","religion":"Catholique","cle_maison":"1871-D1-M50","lieux":[],"trajectoire":null,"maisonnee":{"entetes":["Nom","Sexe","Âge","Né(e)","Origine","Profession","École"],"lignes":[{"id":"1871-D1-P020-L17","ligne":"17","chef":true,"courante":true,"valeurs":["Edouard Lagueux","M","73","Québec","Française","Cultivateur",""]},{"id":"1871-D1-P020-L18","ligne":"18","chef":false,"courante":false,"valeurs":["Marie Lagueux","F","73","Québec","Française","—",""]},{"id":"1871-D1-P020-L19","ligne":"19","chef":false,"courante":false,"valeurs":["Narcisse Coté","M","24","Québec","Française","Domestique",""]},{"id":"1871-D1-P020-L20","ligne":"20","chef":false,"courante":false,"valeurs":["Napoléon Lebel","M","16","Québec","Française","—","✓"]},{"id":"1871-D1-P021-L01","ligne":"1","chef":false,"courante":false,"valeurs":["Suzanne Demers","F","22","Québec","Française","Servante",""]},{"id":"1871-D1-P021-L02","ligne":"2","chef":false,"courante":false,"valeurs":["Malvina Gingras","F","17","Québec","Française","—",""]}]},"evenements":[],"documents":[{"id":"notarie-1874-05-09-lagueux-lepine","titre":"Bail à rente foncière d'Edouard Lagueux à Louis Lépine fils, 1874","type":"notarie","source":"Greffe du notaire Elzéar-Hubert Tremblay (1873-1900), Saint-Romuald — microfilm","cote":"Minute n° 113, images 001496 à 001501","date":"1874-05-09","transcription":"« Fut présent : Edouard [Etienne, rayé] Lagueux, écuyer, Juge de Paix de Sa Majesté & rentier, demeurant en la paroisse de St Romuald ; Lequel a par ces présentes baillé & concédé dès ce jour & à toujours à titre de bail à rente foncière & constituée […] à Sieur Louis Lépine, fils, du même lieu, commerçant […] un emplacement situé en ladite paroisse de St Romuald dit comté, contenant cinquante pieds de front sur cent pieds de profondeur le tout mesure anglaise ; borné au sud ouest aux concédant, au nord-est au terrain de la corporation scolaire, & au sud est au dit concédant, (1) et au nord-ouest à Joseph Larochelle […] » — Charges : rente de douze piastres courant payable d'avance le premier jour de mai de chaque année, rachetable au capital de deux cents piastres ; bâtir une maison habitable avec cheminées en pierres ou en briques d'ici à trois ans ; clore l'emplacement ; fournir au côté nord un chemin d'au moins douze pieds de largeur ; copie enregistrée au concédant. Renvoi (3) : le bail sera nul si le concessionnaire néglige de payer la rente d'avance. — Renvoi (4), au nom du concessionnaire : « dit Marest ». Renvoi en marge de la dernière page : en cas de résolution, « tous les paiements alors faits, ainsi que toutes les constructions & améliorations faites sur le dit emplacement appartiendront au dit concédant, ses hoirs & ayants cause » sans indemnité, la clause n'étant pas comminatoire. Clôture : « Dont acte. Fait & passé à St Romuald susdit, demeure du dit concédant, les jour, mois & an susdits, sous le numéro cent treize des originaux du notaire soussigné. Et les dits concédant & concessionnaire ont signé avec moi, notaire, lecture faite. » Signatures : « E. Lagueux », « Louis Lépine dit Marest fils », « E. H. Tremblay N.P. »","affirmations":[{"enonce":"Edouard Lagueux est écuyer, juge de paix et rentier en 1874.","certitude":"etabli","type":"fonction"},{"enonce":"Le juge de paix Edouard Lagueux est le cultivateur de 73 ans recensé en 1871 ; aucun autre Edouard Lagueux dans la paroisse.","certitude":"probable","type":"identite"}]},{"id":"notarie-1874-05-12-couture-michaud","titre":"Cession par Frédérick Couture à Georges Michaud de l'entretien de la route des Quarante-Arpents, 1874","type":"notarie","source":"Greffe du notaire Elzéar-Hubert Tremblay (1873-1900), Saint-Romuald — microfilm","cote":"Minute n° 114, images 001501 à 001511","date":"1874-05-12","transcription":"« L'an mil huit cent soixante-quatorze, le douzième jour de mai, avant midi, en présence de Me Elzéar Hubert Tremblay, notaire public […] résidant & pratiquant en la paroisse de St Romuald, comté de Lévis, soussigné, (1) [et en présence de Théodule Bégin, du même lieu, hôtellier, témoin au présent acte, aussi soussigné] ; Fut présent : Sr Frédérick [Patrick, rayé] Couture, demeurant en la paroisse de St Jean Chrysostome dit comté, fermier & cultivateur ; Lequel dit & déclare ce qui suit, savoir : Attendu que lui, dit sieur Couture, est devenu à St Romuald, en la salle des séances du Conseil de comté, vers le vingt ou vingt-cinq du mois d'avril dernier, l'adjudicataire d'une certaine route appelée route des Quarante-Arpents, pour le prix et somme de cent quatre-vingt-dix-neuf piastres courant que le dit Conseil de comté a agréé & convenu de lui payer pour l'entretien de la dite route […] ; Attendu que le dit sieur Couture a, à l'entière satisfaction du dit Conseil de comté, donné caution suffisante & approuvée du dit Conseil en la personne de sieur Simon Côté, du dit lieu de St Jean Chrysostome, cultivateur ; […] C'est pourquoi le dit sieur Frédérick Couture cède, transporte & abandonne tous les droits qu'il a & pourrait avoir en sa qualité d'adjudicataire susdit à sieur Georges Michaud, du même lieu, fermier cultivateur, à ce présent & acceptant, cessionnaire pour lui, ses hoirs & ayants cause, aux mêmes conditions & sous les mêmes obligations & restrictions […] » — [001505-06] « … que ledit sieur Couture y était lui-même obligé, et promet & s'oblige de se conformer entièrement à tous les règlements relatifs à la dite adjudication, lesquels ont été, à l'entière satisfaction du cessionnaire, expliqués par ledit cédant […] dont ils se déclarent contents & satisfaits. » — [001506-07] « La présente cession est faite sans novation ni dérogation aux droits & privilèges que possède le dit Conseil de comté relativement au cautionnement donné par le dit sieur Côté en faveur du cédant, [le dit Côté] à ce aussi présent & après que lecture de ce qui précède lui a été faite par le dit notaire soussigné, en présence du dit témoin, voulant & entendant que le cautionnement par lui donné comme dit est, serve & vaille en faveur du dit cédant, ce dernier se reconnaissant obligé envers le dit Conseil de comté de même que si la présente cession n'eût jamais eu lieu […] » — [001507-08] « Fut aussi présent Pierre Lagueux, écuyer, juge de paix, demeurant au dit lieu de St Romuald ; Lequel, après que lecture lui a été faite par le notaire soussigné de ce qui précède & en avoir pris communication, déclare l'avoir pour agréable & se porte caution solidaire en faveur du dit sieur Michaud, entendant le dit Pierre Lagueux, écr, qu'il ne pourra être contraint & obligé de remplir les obligations contractées pour l'entretien de la dite route […] que lorsque ce dernier, le dit sieur Côté caution du cédant, & le dit sieur Michaud cessionnaire en ces présentes auront été discutés. » — [001508-09] « La présente cession est faite pour bonnes & valables considérations […] savoir : pour & en considération de la somme de douze piastres courant, sur & en à-compte de laquelle le dit cédant reconnaît avoir eu & reçu lors de l'exécution des présentes, à la vue & présence de nous notaire & témoin, en bon argent courant, celle de quatre piastres, dont quittance d'autant. Et quant à la balance de huit piastres courant, le cessionnaire s'oblige la payer au premier de novembre prochain […] » — [001509-10] « […] être payé du prix de l'entretien de ladite route, comme susdit. — Laquelle dite somme de douze piastres étant en considération de matériaux, connus des parties, que le dit cédant s'oblige délivrer à demande au dit cessionnaire, lesquels matériaux devant servir à l'entretien de ladite route, & consistant en un cent de perches, deux cents de piquets & en sept morceaux de bois de sapin & de pruche équarris ; le tout se trouvant sur la ferme qu'occupe le cédant. » — [001510-11] « Dont acte fait & passé à St Romuald susdit, étude du dit notaire, les jour, mois & an susdits, sous le numéro cent quatorze des originaux du notaire soussigné. Et les dits sieurs Michaud & Pierre Lagueux, écr, ont signé avec moi notaire ; les dits sieurs Couture & Côté ayant déclaré ne le savoir, de ce requis, en présence du dit témoin qui a alors signé avec moi, notaire, lecture faite. » Signatures : « George Michaud », « Théodule Bégin », « Pierre Lagueux », « E. H. Tremblay N.P. »","affirmations":[{"enonce":"Pierre Lagueux (39 ans en 1871) pourrait être le fils d'Edouard Lagueux (73 ans), juge de paix lui aussi (acte n° 113) — à confirmer par un acte de baptême ou de mariage.","certitude":"hypothese","type":"filiation"}]}]},"1871-D1-P020-L18":{"id":"1871-D1-P020-L18","nom":"Lagueux","prenom":"Marie","sexe":"F","age":"73","profession":"","etat_matrimonial":"M","etat_civil