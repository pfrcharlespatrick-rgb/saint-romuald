d":"1871-D2-P027-L18","ligne":"18","chef":false,"courante":true,"valeurs":["Nicolas Mahar","M","23","Q","Irlandaise","—",""]}]},"evenements":[],"documents":[]},"1871-D2-P027-L19":{"id":"1871-D2-P027-L19","nom":"Cadoret","prenom":"Louis","sexe":"M","age":"70","profession":"Journalier","etat_matrimonial":"M","etat_civil":"Marié(e)","annee":"1871","division":"2","no_maison":"71","no_famille":"89","chef":true,"page_ms":"27","ligne":"19","incertain":false,"remarque":"bloc idx 22 ; Partie6 p.6 demi-cadre bas ; lecture visuelle confrontée à l'index BAC ; lecture « 71 » possible ; index BAC = 71, le ms paraît porter 70\" Relecture du manuscrit : l'âge se lit 70","biffee":false,"lieu_naissance":"Q","origine":"Français","religion":"Catholique","cle_maison":"1871-D2-M71","lieux":[],"trajectoire":{"mentions":[{"id":"1871-D2-P027-L19","annee":"1871","division":"2","nom":"Louis Cadoret","attribut":"70 ans · maison 71, famille 89 · chef(fe) de ménage","page_ms":"27","ligne":"19"},{"id":"1881-D2-P033-L13","annee":"1881","division":"2","nom":"Louis Cadorette","attribut":"81 ans · maison 136, famille 149 · chef(fe) de ménage","page_ms":"33","ligne":"13"}],"liaisons":[{"confiance":"forte","motifs":["patronyme proche (Cadoret / Cadorette)","prénom concordant","âge cohérent (70 → 81, écart de 10 ans)","sexe concordant"],"score":0.86}]},"maisonnee":{"entetes":["Nom","Sexe","Âge","Né(e)","Origine","Profession","École"],"lignes":[{"id":"1871-D2-P027-L19","ligne":"19","chef":true,"courante":true,"valeurs":["Louis Cadoret","M","70","Q","Français","Journalier",""]},{"id":"1871-D2-P027-L20","ligne":"20","chef":false,"courante":false,"valeurs":["Elisabeth Cadoret","F","71","Q","Français","—",""]}]},"evenements":[],"documents":[{"id":"notarie-1874-06-26-resiliation-donation-cadorette","titre":"Résiliation de la donation de Louis Cadorette père et d'Élisabeth Blanchet à leur fils Louis, 1874","type":"notarie","source":"Greffe du notaire Elzéar-Hubert Tremblay (1873-1900), Saint-Romuald — microfilm","cote":"Minute n° 133, images 001587 à 001589 (Drive : fichiers 04T_CN401S124P_00643 à 00645) ; acte complet, mais le fichier 00644 est tronqué au Drive.","date":"1874-06-26","transcription":"[001587-88] « N° 133 — 26 juin 1874. L'an mil huit cent soixante-quatorze, le vingt-sixième jour de juin, après-midi, en présence de Elzéar Hubert Tremblay, notaire public […], soussigné ; Et en présence de Germain Cantin, écuier, marchand, du dit lieu de St Romuald, témoin au présent acte, aussi soussigné ; Furent présents : Sieur Louis Cadorette, père, journalier, & Dame Elizabeth Blanchet, son épouse, qu'il autorise bien & dûment à l'effet des présentes, demeurant tous deux en la paroisse de St Romuald, d'une part ; [001588-89] Et sieur Louis Cadorette, fils, ci-devant de St Romuald, & maintenant de la paroisse de Ste Agathe, dans le comté de Lotbinière, cultivateur, d'autre part ; Lesquelles parties, pour raisons d'elles connues, ont résilié, rescindé & annulé, comme par ces présentes elles résilient, rescindent & annulent, un certain acte de donation entrevifs consenti par les dits sieur [&] dame Cadorette en faveur [du dit Louis Cadorette, fils …] [moitié basse de l'image perdue : fichier tronqué] — [001589-90] […] est & demeurera de ce jour & à toujours nul & de nul effet. Dont & du tout les parties ont requis le présent acte, qui leur a été octroyé à St Romuald susdit, étude du dit notaire, les jour, mois & an susdits, sous le numéro cent trente-trois des originaux du notaire soussigné. Requises de signer, les parties ont déclaré ne le savoir, en présence du dit témoin, qui a alors signé avec moi, notaire, lecture faite. Neuf mots rayés sont nuls. » Signatures : « Germain Cantin », « E. H. Tremblay N.P. »","affirmations":[]}]},"1871-D2-P027-L20":{"id":"1871-D2-P027-L20","nom":"Cadoret","prenom":"Elisabeth","sexe":"F","age":"71","profession":"","etat_matrimonial":"M","etat_civil":"Marié(e)","annee":"1871","division":"2","no_maison":"71","no_famille":"89","chef":false,"page_ms":"27","ligne":"20","incertain":false,"remarque":"bloc idx 22 ; Partie6 p.6 demi-cadre bas ; lecture visuelle confrontée à l'index BAC","biffee":false,"lieu_naissance":"Q","origine":"Français","religion":"Catholique","cle_maison":"1871-D2-M71","lieux":[],"trajectoire":null,"maisonnee":{"entetes":["Nom","Sexe","Âge","Né(e)","Origine","Profession","École"],"lignes":[{"id":"1871-D2-P027-L19","ligne":"19","chef":true,"courante":false,"valeurs":["Louis Cadoret","M","70","Q","Français","Journalier",""]},{"id":"1871-D2-P027-L20","ligne":"20","chef":false,"courante":true,"valeurs":["Elisabeth Cadoret","F","71","Q","Français","—",""]}]},"evenements":[],"documents":[{"id":"notarie-1874-06-26-resiliation-donation-cadorette","titre":"Résiliation de la donation de Louis Cadorette père et d'Élisabeth Blanchet à leur fils Louis, 1874","type":"notarie","source":"Greffe du notaire Elzéar-Hubert Tremblay (1873-1900), Saint-Romuald — microfilm","cote":"Minute n° 133, images 001587 à 001589 (Drive : fichiers 04T_CN401S124P_00643 à 00645) ; acte complet, mais le fichier 00644 est tronqué au Drive.","date":"1874-06-26","transcription":"[001587-88] « N° 133 — 26 juin 1874. L'an mil huit cent soixante-quatorze, le vingt-sixième jour de juin, après-midi, en présence de Elzéar Hubert Tremblay, notaire public […], soussigné ; Et en présence de Germain Cantin, écuier, marchand, du dit lieu de St Romuald, témoin au présent acte, aussi soussigné ; Furent présents : Sieur Louis Cadorette, père, journalier, & Dame Elizabeth Blanchet, son épouse, qu'il autorise bien & dûment à l'effet des présentes, demeurant tous deux en la paroisse de St Romuald, d'une part ; [001588-89] Et sieur Louis Cadorette, fils, ci-devant de St Romuald, & maintenant de la paroisse de Ste Agathe, dans le comté de Lotbinière, cultivateur, d'autre part ; Lesquelles parties, pour raisons d'elles connues, ont résilié, rescindé & annulé, comme par ces présentes elles résilient, rescindent & annulent, un certain acte de donation entrevifs consenti par les dits sieur [&] dame Cadorette en faveur [du dit Louis Cadorette, fils …] [moitié basse de l'image perdue : fichier tronqué] — [001589-90] […] est & demeurera de ce jour & à toujours nul & de nul effet. Dont & du tout les parties ont requis le présent acte, qui leur a été octroyé à St Romuald susdit, étude du dit notaire, les jour, mois & an susdits, sous le numéro cent trente-trois des originaux du notaire soussigné. Requises de signer, les parties ont déclaré ne le savoir, en présence du dit témoin, qui a alors signé avec moi, notaire, lecture faite. Neuf mots rayés sont nuls. » Signatures : « Germain Cantin », « E. H. Tremblay N.P. »","affirmations":[{"enonce":"Élisabeth, épouse de Louis Cadoret (Cadorette) père, journalier de Saint-Romuald, est née Élisabeth Blanchet.","certitude":"probable","type":"nom_de_naissance"}]}]}}