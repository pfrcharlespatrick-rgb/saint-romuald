ien adulte dès 1853.","certitude":"hypothese","type":"identite"}]}]},"1891-D1-M631":{"cle":"1891-D1-M631","annee":"1891","division":"1","no_maison":"631","division_reconstituee":"1","appui_division":"par continuité du parcours du recenseur (aucun lien vers 1881)","no_famille_ms":"621","logement":{"code_ms":"B 1/10","materiau":"Bois","etages":1,"chambres":10,"col4_verifiee":true,"incertain":true},"logement_partage":false,"remarque_logement":"Passe colonne 4 (recueil PDF « 189102DIV12 », lecture ancrée sur le numéro de famille voisin) : « B 2/10 » au dépouillement, « B 1/10 » au manuscrit.","remarque_nom":"","remarque":"","familles":[{"no_famille":"631","chef":"Deans Joseph","no_famille_ms":"","remarque_nom":"","entetes":["Nom","Sexe","Âge","Lien avec le chef","Né(e)","Religion","Profession","Lit / écrit"],"membres":[{"id":"1891-D1-P140-L17","ligne":"17","chef":true,"valeurs":["Joseph Deans","M","33","Chef","Québec","C.R.","Cultivateur","lit et écrit"]},{"id":"1891-D1-P140-L18","ligne":"18","chef":false,"valeurs":["Eliza Deans","F","28","Sœur","Québec","C.R.","—","lit et écrit"]},{"id":"1891-D1-P140-L19","ligne":"19","chef":false,"valeurs":["Esther Deans","F","66","Mère","Québec","C.R.","—","lit et écrit"]}],"devenir":[]}],"renvois":{},"concordances":[],"lieux":[],"documents":[]},"1891-D1-M632":{"cle":"1891-D1-M632","annee":"1891","division":"1","no_maison":"632","division_reconstituee":"1","appui_division":"par continuité du parcours du recenseur (aucun lien vers 1881)","no_famille_ms":"622","logement":{"code_ms":"B 1/4","materiau":"Bois","etages":1,"chambres":4,"col4_verifiee":true,"incertain":true},"logement_partage":false,"remarque_logement":"Passe colonne 4 (recueil PDF « 189102DIV12 », lecture ancrée sur le numéro de famille voisin) : « B 2/1 » au dépouillement, « B 1/4 » au manuscrit.","remarque_nom":"","remarque":"","familles":[{"no_famille":"632","chef":"Racine Angèle","no_famille_ms":"","remarque_nom":"","entetes":["Nom","Sexe","Âge","Lien avec le chef","Né(